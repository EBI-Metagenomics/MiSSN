#!/bin/bash
#SBATCH --time=06:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem=50G

export DIAMOND_THREADS=${SLURM_CPUS_PER_TASK:-1}
export SINGULARITY_IMG="/hps/nobackup/rdf/metagenomics/service-team/singularity-cache/depot.galaxyproject.org-singularity-diamond-2.1.12--hdb4b4cc_1.img"

MAX_CLUSTERS=0

while getopts "f:o:m:" option; do
  case $option in
    f) FASTA_DIR=$OPTARG ;;
    o) OUT_DIR=$OPTARG ;;
    m) MAX_CLUSTERS=$OPTARG ;;
    *)
      echo "Usage: sbatch $0 -f <fasta_dir> -o <out_dir> [-m max_clusters]" >&2
      exit 1
      ;;
  esac
done

if [ -z "$FASTA_DIR" ] || [ -z "$OUT_DIR" ]; then
  echo "Usage: sbatch $0 -f <fasta_dir> -o <out_dir>" >&2
  exit 1
fi

if [ ! -d "$FASTA_DIR" ]; then
  echo "Error: Folder '$FASTA_DIR' containing fasta files not found." >&2
  exit 1
fi

mkdir -p "$OUT_DIR"

run_diamond() {
  local FASTA_FILE=$1
  
  # Get the filename and safely strip the extension (.fasta, .fa, .faa)
  local FILENAME=$(basename "$FASTA_FILE")
  local CLUSTER_NAME="${FILENAME%.*}"

  singularity run "$SINGULARITY_IMG" diamond makedb \
    --in "$FASTA_FILE" \
    --db "$OUT_DIR/${CLUSTER_NAME}" \
    --threads "$DIAMOND_THREADS" \
    --quiet

  # Run all-vs-all blastp
  singularity run "$SINGULARITY_IMG" diamond blastp \
    --query "$FASTA_FILE" \
    --db "$OUT_DIR/${CLUSTER_NAME}.dmnd" \
    --out "$OUT_DIR/${CLUSTER_NAME}.tsv" \
    --outfmt 6 qseqid sseqid pident length qlen slen positive evalue bitscore \
    -k 0 \
    --no-self-hits \
    --fast \
    -p "$DIAMOND_THREADS" \
    --quiet

  # Cleanup
  rm "$OUT_DIR/${CLUSTER_NAME}.dmnd"
}

export -f run_diamond

echo "[$(date +%H:%M:%S)] Calculating DIAMOND all-vs-all alignments on $DIAMOND_THREADS threads..."

PROCESSED=0

# Loop through possible FASTA extensions
for file in "$FASTA_DIR"/*.{fasta,fa,faa}; do
  [ -e "$file" ] || continue
  
  if [ "$MAX_CLUSTERS" -gt 0 ] && [ "$PROCESSED" -ge "$MAX_CLUSTERS" ]; then
    echo "Reached maximum limit of $MAX_CLUSTERS clusters. Stopping alignment."
    break
  fi

  run_diamond "$file"

  ((PROCESSED++))
done

echo "[$(date +%H:%M:%S)] Alignments completed."
