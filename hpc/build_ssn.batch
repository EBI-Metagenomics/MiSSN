#!/bin/bash
#SBATCH --time=06:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem=100G

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
if [ -f "$SLURM_SUBMIT_DIR/scripts/build_ssn.py" ]; then
  PYTHON_SCRIPT="$SLURM_SUBMIT_DIR/scripts/build_ssn.py"
elif [ -f "$SLURM_SUBMIT_DIR/../scripts/build_ssn.py" ]; then
  PYTHON_SCRIPT="$SLURM_SUBMIT_DIR/../scripts/build_ssn.py"
else
  echo "Error: Cannot locate build_ssn.py. Please submit from the MiSSN or MiSSN/hpc directory." >&2
  exit 1
fi

while getopts "e:b:p:o:i:c:g:" option; do
  case $option in
  e) EDGE_LIST_DIR=$OPTARG ;;
  b) BIOME_METADATA_FILE=$OPTARG ;;
  p) PFAM_METADATA_FILE=$OPTARG ;;
  o) OUT_DIR=$OPTARG ;;
  i) MIN_SEQ_ID=$OPTARG ;;
  c) MIN_COVERAGE=$OPTARG ;;
  g) GROUP_PARTS=$OPTARG ;;
  *)
    echo "Usage: sbatch $0 -e <edge_list_dir> -b <biome_metadata_file> -p <pfam_metadata_file> -o <out_dir> -i <min_seq_id> -c <min_coverage> [-g <group_parts>]" >&2
    exit 1
    ;;
  esac
done

if [ -z "$EDGE_LIST_DIR" ] || [ -z "$BIOME_METADATA_FILE" ] || [ -z "$PFAM_METADATA_FILE" ] || [ -z "$OUT_DIR" ] || [ -z "$MIN_SEQ_ID" ] || [ -z "$MIN_COVERAGE" ]; then
  echo "Usage: sbatch $0 -e <edge_list_dir> -b <biome_metadata_file> -p <pfam_metadata_file> -o <out_dir> -i <min_seq_id> -c <min_coverage> [-g <group_parts>]" >&2
  exit 1
fi

if [ ! -d "$EDGE_LIST_DIR" ]; then
  echo "Error: Edge list directory '$EDGE_LIST_DIR' not found." >&2
  exit 1
fi

if [ ! -f "$BIOME_METADATA_FILE" ]; then
  echo "Error: Biome metadata file '$BIOME_METADATA_FILE' not found." >&2
  exit 1
fi

if [ ! -f "$PFAM_METADATA_FILE" ]; then
  echo "Error: Pfam metadata file '$PFAM_METADATA_FILE' not found." >&2
  exit 1
fi

echo "[$(date +%H:%M:%S)] Starting SSN build process..."

if [ -n "$GROUP_PARTS" ]; then
  # If -g was provided
  python3 "$PYTHON_SCRIPT" \
    -e "$EDGE_LIST_DIR" \
    -b "$BIOME_METADATA_FILE" \
    -p "$PFAM_METADATA_FILE" \
    -o "$OUT_DIR" \
    -i "$MIN_SEQ_ID" \
    -c "$MIN_COVERAGE" \
    -g "$GROUP_PARTS"
else
  # If -g was NOT provided Python will use its default
  python3 "$PYTHON_SCRIPT" \
    -e "$EDGE_LIST_DIR" \
    -b "$BIOME_METADATA_FILE" \
    -p "$PFAM_METADATA_FILE" \
    -o "$OUT_DIR" \
    -i "$MIN_SEQ_ID" \
    -c "$MIN_COVERAGE"
fi

echo "[$(date +%H:%M:%S)] SSN build process completed."
